{
  "version": 4,
  "include": [
    "../cmake/common.json"
  ],
  "configurePresets": [
    {
      "name": "macos-cpu",
      "displayName": "macOS standard (Eigen CPU)",
      "inherits": "gogame-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "GOGAME_KATAGO_BACKEND": "EIGEN"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-cpu",
      "inherits": "gogame-release-build",
      "configurePreset": "macos-cpu",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ]
}
