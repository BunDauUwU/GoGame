{
  "version": 4,
  "configurePresets": [
    {
      "name": "gogame-release",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/release/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GOGAME_ENABLE_KATAGO": true,
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/release/build/${presetName}/bin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gogame-release-build",
      "hidden": true,
      "configuration": "Release",
      "targets": ["appGoGame"],
      "jobs": 2
    }
  ]
}
