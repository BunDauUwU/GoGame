cmake_minimum_required(VERSION 3.23)

set(profiles windows-cpu linux-cpu macos-cpu windows-cuda linux-cuda)
if(NOT GOGAME_RELEASE IN_LIST profiles)
    message(FATAL_ERROR "Set GOGAME_RELEASE to one of: ${profiles}")
endif()

get_filename_component(game_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
string(REPLACE "-" ";" parts "${GOGAME_RELEASE}")
list(GET parts 0 platform)
list(GET parts 1 backend)
if(backend STREQUAL "cpu")
    set(backend EIGEN)
else()
    set(backend CUDA)
endif()

set(build_path "${game_root}/release/build/${GOGAME_RELEASE}")
if(DEFINED GOGAME_BUILD_DIR)
    get_filename_component(build_path "${GOGAME_BUILD_DIR}" ABSOLUTE BASE_DIR "${game_root}")
endif()
if(NOT EXISTS "${build_path}/CMakeCache.txt")
    message(FATAL_ERROR "Configure and build ${GOGAME_RELEASE} first: ${build_path}")
endif()

file(STRINGS "${build_path}/CMakeCache.txt" enabled REGEX "^GOGAME_ENABLE_KATAGO:[^=]+=")
string(REGEX REPLACE "^[^=]*=" "" enabled "${enabled}")
file(STRINGS "${build_path}/CMakeCache.txt" selected REGEX "^GOGAME_KATAGO_BACKEND:[^=]+=${backend}$")
file(STRINGS "${build_path}/CMakeCache.txt" configuration REGEX "^CMAKE_BUILD_TYPE:[^=]+=Release$")
if(NOT enabled OR NOT selected OR NOT configuration)
    message(FATAL_ERROR "${GOGAME_RELEASE} requires a Release build with KataGo ON and backend ${backend}")
endif()

set(binary_dir "${build_path}/bin")
if(platform STREQUAL "windows")
    set(binary appGoGame.exe)
    set(launcher run-gogame.cmd)
elseif(platform STREQUAL "macos")
    set(binary appGoGame.app)
    set(launcher run-gogame.command)
else()
    set(binary appGoGame)
    set(launcher run-gogame.sh)
endif()
if(NOT EXISTS "${binary_dir}/${binary}" AND DEFINED GOGAME_BUILD_DIR)
    set(binary_dir "${build_path}")
endif()
if(NOT EXISTS "${binary_dir}/${binary}")
    message(FATAL_ERROR "Client not found: ${binary_dir}/${binary}. Build appGoGame before staging.")
endif()

set(model_path "${game_root}/tools/b10c384h6nbttflrs.bin.gz")
if(DEFINED GOGAME_KATAGO_MODEL)
    get_filename_component(model_path "${GOGAME_KATAGO_MODEL}" ABSOLUTE BASE_DIR "${game_root}")
endif()
if(NOT EXISTS "${model_path}" OR IS_DIRECTORY "${model_path}")
    message(FATAL_ERROR "Model not found: ${model_path}. Set GOGAME_KATAGO_MODEL to a .bin.gz model.")
endif()

set(stage_path "${game_root}/release/staging/${GOGAME_RELEASE}")
file(MAKE_DIRECTORY "${stage_path}")
file(COPY "${binary_dir}/${binary}" DESTINATION "${stage_path}")
if(platform STREQUAL "macos")
    set(model_file "appGoGame.app/Contents/Resources/models/model.bin.gz")
else()
    set(model_file "models/model.bin.gz")
endif()
get_filename_component(model_dir "${stage_path}/${model_file}" DIRECTORY)
file(MAKE_DIRECTORY "${model_dir}")
configure_file("${model_path}" "${stage_path}/${model_file}" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/${platform}/${launcher}" "${stage_path}/${launcher}" COPYONLY)
if(NOT platform STREQUAL "windows")
    file(CHMOD "${stage_path}/${launcher}"
        PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()

string(TIMESTAMP prepared_at "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${stage_path}/release.json"
    "{\n  \"profile\": \"${GOGAME_RELEASE}\",\n  \"platform\": \"${platform}\",\n  \"backend\": \"${backend}\",\n  \"configuration\": \"Release\",\n  \"preparedAtUtc\": \"${prepared_at}\",\n  \"model\": \"${model_file}\",\n  \"packaged\": false\n}\n")
file(MAKE_DIRECTORY "${game_root}/release/packages/${GOGAME_RELEASE}")
message(STATUS "Staged ${GOGAME_RELEASE}: ${stage_path}")
message(STATUS "Qt and backend runtime deployment is still required before distribution.")
